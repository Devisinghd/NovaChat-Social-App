# Python Bytecode (compiled files generated at runtime)
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments (always recreate via requirements.txt or pyproject.toml)
venv/
.venv/
env/
ENV/

# Sensitive Data & Configurations (never commit passwords or secret keys)
.env
*.env
local_settings.py

# Databases (local SQLite databases should stay local)
db.sqlite3
*.sqlite3

# Django Specific Media & Static Collections
media/
staticfiles/
static_root/

# Logs & Backups
*.log
*.bak

# Testing & Coverage Reports
.coverage
htmlcov/
.pytest_cache/
.tox/

# IDE and Code Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# Operating System Files
.DS_Store
Thumbs.db
